AGENT_IMAGE_EDIT_MODEL=baidu/ERNIE-Image-Turbo

# ─── 视频生成模式 ───────────────────────────────────────
# 0=异步（默认，推荐）：pipeline 提交视频任务即返回 requestId，前端轮询
#   /api/video/status/<requestId> 拿结果，不阻塞整条流水线。
# 1=同步内联：阻塞 pipeline 直到视频生成完（约 1-3 分钟）。
AGENT_VIDEO_INLINE=0
AGENT_VIDEO_POLL_INTERVAL=5
# 同步模式下内联轮询最长等待秒数
AGENT_VIDEO_INLINE_TIMEOUT=300

# ─── Python 运行时（可选）────────────────────────────────
# crewai 不支持 Python 3.14。若本机默认 python 为 3.14，请用 3.11/3.12 建 venv
# 并将本变量指向该 venv 的 python，Next.js 后端脚本会用它来 spawn：
#   py -3.12 -m venv crew/.venv
#   crew/.venv/Scripts/pip install -r crew/requirements.txt  # 国内加 -i 镜像源
# PYTHON_EXECUTABLE=D:/crewmarket/crew/.venv/Scripts/python.exe
